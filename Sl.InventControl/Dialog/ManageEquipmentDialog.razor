@using Sl.InventControl.Data;

@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>        
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1"/>
            @Caption
        </MudText>        
    </TitleContent>
    
    <DialogContent>
        <MudItem xs="12" >
            
            <MudPaper>
                <MudStack>

                    
                    <MudSelect T="EquipmentCategoryModel" Label="Manufacturer" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="@SelectedManufacturer" ToStringFunc="@manufacturerConverter" Style="width: 200px;">
                        @foreach (var manufacturer in EquipmentTypes) {
                            <MudSelectItem T="EquipmentCategoryModel" Value="manufacturer">@(manufacturer.Manufacturer)</MudSelectItem>
                        }
                    </MudSelect>
                    
                    <MudSelect T="ManufacturerCategoryModel" Label="Type" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="@SelectedCategory" ToStringFunc="@typeConverter" Style="width: 200px;">
                        @if(SelectedManufacturer != null) {
                            @foreach (var type in SelectedManufacturer?.Categories) {
                                <MudSelectItem T="ManufacturerCategoryModel" Value="type">@(type.Type)</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="ManufacturerModelModel" Label="Model" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="@SelectedModel" ToStringFunc="@modelConverter" Style="width: 200px;">
                        @if(SelectedCategory != null) {
                            @foreach (var model in SelectedCategory?.Models) {
                                <MudSelectItem T="ManufacturerModelModel" Value="model">@(model.Model)</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="EquipmentLocationModel" Label="Location" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="@Item.Location" ToStringFunc="@locationConverter" Style="width: 200px;">
                        @foreach (var location in EquipmentLocations) {
                            <MudSelectItem T="EquipmentLocationModel" Value="location">@(location.Name)</MudSelectItem>
                        }
                    </MudSelect>
                    
                    <MudTextField @bind-Value="@Item.Remark" Label="Remark" ReadOnly="false" />

                    <MudTextField @bind-Value="@Item.SerialNumber" Label="Serial" ReadOnly="false" OnKeyDown="OnKeyDown" Immediate="true" />

                </MudStack>
            </MudPaper>

            
        </MudItem>
    </DialogContent>
    
    
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Success" OnClick="ExecuteOkClick">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public string Caption { get; set; } = "Confirm?";

    [Parameter] 
    public string SnackbarInfo { get; set; } = "action confirmed";

    [Parameter]
    public List<EquipmentCategoryModel> EquipmentTypes { get; set; } = new();

    [Parameter]
    public List<EquipmentLocationModel> EquipmentLocations { get; set; } = new();

    EquipmentCategoryModel? _selectedManufacturer;
    [Parameter]
    public EquipmentCategoryModel? SelectedManufacturer { 
        get => _selectedManufacturer; 
        set {
            _selectedManufacturer = value;
            SelectedCategory = value?.Categories?.FirstOrDefault();
            StateHasChanged();
        } 
    }

    ManufacturerCategoryModel? _selectedCategory;
    [Parameter]
    public ManufacturerCategoryModel? SelectedCategory {
        get => _selectedCategory;
        set {
            _selectedCategory = value;
            SelectedModel = value?.Models?.FirstOrDefault();
            StateHasChanged();
        } 
    }

    [Parameter]
    public ManufacturerModelModel? SelectedModel { get; set; }

    [Parameter]
    public EquipmentModel Item { get; set; } = new() {
        Type = new(),
        Location = new()
    };

    readonly Func<EquipmentCategoryModel, string> manufacturerConverter = p => p?.Manufacturer ?? "N/A";
    readonly Func<ManufacturerCategoryModel, string> typeConverter = p => p?.Type ?? "N/A";
    readonly Func<ManufacturerModelModel, string> modelConverter = p => p?.Model ?? "N/A";
    readonly Func<EquipmentLocationModel, string> locationConverter = p => p?.Name ?? "N/A";


    private void Cancel() {
        MudDialog.Cancel();
        MudDialog.Close(DialogResult.Cancel());
    }


    async void OnKeyDown(KeyboardEventArgs args) {
        if (args.Key == "Enter") {
            if(!string.IsNullOrEmpty(Item.SerialNumber) 
            && !string.IsNullOrEmpty(Item.Location.Name)
            && !string.IsNullOrEmpty(Item.Type.Type)) {
                ExecuteOkClick();
            }
        }
    }

    private void ExecuteOkClick() {

        if(string.IsNullOrEmpty(Item.SerialNumber) || Item.Type == null) {
            Snackbar.Add("Please provide at least a serial number and Type", Severity.Warning);
        }
        else if (SelectedManufacturer == null || SelectedCategory == null || SelectedModel == null) {
            Snackbar.Add("Please provide a manufacturer, type and model", Severity.Warning);
        }
        else {

            Snackbar.Add(SnackbarInfo, Severity.Success);
            Item.Type.Make = SelectedManufacturer.Manufacturer;
            Item.Type.Type = SelectedCategory.Type;
            Item.Type.Model = SelectedModel.Model;

            MudDialog.Close(DialogResult.Ok(Item));
        }

    }
}
